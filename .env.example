# Copy to .env and fill in. Never commit .env.
AMAZON_ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
AMAZON_ADS_CLIENT_SECRET=
# From `adsctl auth exchange`. Expires 365 days after consent; refreshing does not extend it.
# Resetting the client secret revokes every refresh token issued under it.
AMAZON_ADS_REFRESH_TOKEN=
# YYYY-MM-DD of the consent, so `adsctl auth check` can warn before expiry.
AMAZON_ADS_CONSENT_DATE=
# Only needed for `adsctl auth url` and `adsctl auth exchange`.
AMAZON_ADS_REDIRECT_URI=https://localhost:8400/callback

# MCP server (optional)
# AMAZON_ADS_MCP_READ_ONLY=1
# AMAZON_ADS_MCP_PLAN_DIR=~/.local/state/amazon-ads/plans
# AMAZON_ADS_MCP_DB=~/ads.sqlite
